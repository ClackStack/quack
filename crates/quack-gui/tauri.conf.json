{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quack",
  "identifier": "dev.clackstack.quack",
  "bundle": {
    "active": true,
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "homepage": "https://quack.clackstack.dev",
    "category": "DeveloperTool",
    "shortDescription": "Desktop coding agent for open-weight models",
    "longDescription": "Desktop client for quack, a local-first coding agent for open-weight models.",
    "copyright": "Copyright 2026 Paul Hovey",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "quack",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  }
}
