{
  "$defs": {
    "HookBinding": {
      "properties": {
        "connection": {
          "$ref": "#/$defs/HookConnection"
        },
        "credentials": {
          "additionalProperties": {
            "$ref": "#/$defs/Secret"
          },
          "default": {},
          "type": "object"
        },
        "managed_credentials": {
          "description": "Fields whose credential entries were created by setup. External references\nnever acquire ownership merely because they use the same name or directory.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "connection"
      ],
      "type": "object"
    },
    "HookConnection": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "id",
        "preset"
      ],
      "type": "object"
    },
    "HookDescriptor": {
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/HookField"
          },
          "type": "array"
        },
        "presets": {
          "items": {
            "$ref": "#/$defs/HookPreset"
          },
          "type": "array"
        },
        "scope_field": {
          "description": "Connection value containing the web base used to scope access checks.",
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "scope_field",
        "fields",
        "presets"
      ],
      "type": "object"
    },
    "HookEvent": {
      "oneOf": [
        {
          "const": "session_start",
          "description": "A session opens: at startup, `/new` or `/resume`. Context it returns is added to\nthe session's next prompt.",
          "type": "string"
        },
        {
          "const": "user_prompt",
          "description": "The user sent a prompt. The hook can add context to it, or block it.",
          "type": "string"
        },
        {
          "const": "pre_tool",
          "description": "A tool call is about to run. The hook can allow, deny or ask, and change the\narguments.",
          "type": "string"
        },
        {
          "const": "post_tool",
          "description": "A tool call finished. Context it returns is added to the result the model sees.",
          "type": "string"
        },
        {
          "const": "turn_end",
          "description": "A turn finished or was stopped.",
          "type": "string"
        },
        {
          "const": "session_end",
          "description": "The session closes: on quit, `/new` or `/resume`.",
          "type": "string"
        },
        {
          "const": "pre_compact",
          "description": "The conversation is about to be summarized. Context it returns guides the summary.",
          "type": "string"
        }
      ]
    },
    "HookField": {
      "properties": {
        "advanced": {
          "default": false,
          "type": "boolean"
        },
        "choices": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "credential_scope": {
          "default": false,
          "description": "Changing this value requires an explicit credential change.",
          "type": "boolean"
        },
        "default": {
          "default": "",
          "type": "string"
        },
        "help": {
          "default": "",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "text, url, integer, boolean, choice, or secret.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "required_when": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "type": "object"
    },
    "HookMatch": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "default": "",
          "description": "`pre_tool`, `post_tool`: glob on the call's target: a shell command, a file path\nrelative to the workspace, or otherwise the arguments as JSON.",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "description": "`user_prompt`: regular expression searched for in the prompt. Its matches are sent\nto the command as `matches`.",
          "type": "string"
        },
        "tool": {
          "default": "",
          "description": "`pre_tool`, `post_tool`: tool name glob, e.g. `shell` or `mcp__github__*`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "HookPreset": {
      "properties": {
        "choices": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {},
          "type": "object"
        },
        "derived": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Field templates expanded from the connection values, e.g. {web_url}/api/v4.",
          "type": "object"
        },
        "help": {
          "default": "",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "OnError": {
      "oneOf": [
        {
          "const": "deny",
          "description": "Block what the hook guards (the prompt or the tool call).",
          "type": "string"
        },
        {
          "const": "allow",
          "description": "Carry on quietly (the failure is still logged).",
          "type": "string"
        },
        {
          "const": "warn",
          "description": "Carry on with a warning.",
          "type": "string"
        }
      ]
    },
    "Secret": {
      "anyOf": [
        {
          "description": "Plain value. Allowed, but warns when the file is world-readable or inside a repo.",
          "type": "string"
        },
        {
          "properties": {
            "env": {
              "type": "string"
            },
            "format": {
              "description": "Format string with `{}` for the value, e.g. `\"Bearer {}\"`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "env"
          ],
          "type": "object"
        },
        {
          "description": "Command whose trimmed stdout is the secret. Only honoured from system, user or trusted project layers.",
          "properties": {
            "cmd": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "cmd"
          ],
          "type": "object"
        },
        {
          "description": "OS credential store entry `\"<service>/<user>\"`, or `\"<user>\"` under the\n`quack` service. Store one with `quack keyring set <name>`.",
          "properties": {
            "keyring": {
              "type": "string"
            }
          },
          "required": [
            "keyring"
          ],
          "type": "object"
        },
        {
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      ],
      "description": "A secret value. Secrets never have to be written into TOML in plain text."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "description": "Program and arguments. `{dir}` is this file's folder, `{python}` the Python found on\n`PATH` (`python3`, `python` or `py`), and a leading `~/` the home folder.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "connections": {
      "default": null,
      "description": "When present this list is authoritative, including when empty.",
      "items": {
        "$ref": "#/$defs/HookBinding"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "cwd": {
      "default": "",
      "description": "Working directory; default: the workspace root.",
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "env": {
      "additionalProperties": {
        "$ref": "#/$defs/Secret"
      },
      "default": {},
      "description": "Extra environment variables for the command; values may be secrets.",
      "type": "object"
    },
    "event": {
      "$ref": "#/$defs/HookEvent"
    },
    "full_context": {
      "default": false,
      "description": "Preserve stdout and added context in full. Warn above 8,000 estimated tokens.",
      "type": "boolean"
    },
    "id": {
      "default": null,
      "description": "Defaults to the file stem.",
      "type": [
        "string",
        "null"
      ]
    },
    "inherit_env": {
      "default": null,
      "description": "Variables passed through from the harness's own environment. Default: a minimal set\n(`PATH`, `HOME`, temp and locale variables, proxies, and what Windows needs).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "match": {
      "$ref": "#/$defs/HookMatch",
      "default": {
        "pattern": "",
        "prompt": "",
        "tool": ""
      },
      "description": "Which calls or prompts start the hook. Empty: every one."
    },
    "on_error": {
      "$ref": "#/$defs/OnError",
      "default": "warn",
      "description": "What a failure (a crash, a timeout, unreadable output) means."
    },
    "setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/HookDescriptor"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Declarative setup metadata. Parsed independently so newer forms do not disable a hook."
    },
    "timeout_secs": {
      "default": 10,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "event",
    "command"
  ],
  "title": "HookFile",
  "type": "object"
}
